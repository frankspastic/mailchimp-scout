# Scoutbook Credentials
# Your Scoutbook/MyScouting account username (typically your email)
SCOUTBOOK_USERNAME=your_scoutbook_email@example.com

# Your Scoutbook/MyScouting account password
SCOUTBOOK_PASSWORD=your_scoutbook_password

# Whether to run the browser in headless mode (true/false)
# Set to false if you want to see the browser window during scraping
SCOUTBOOK_HEADLESS=true


# Mailchimp Configuration
# Your Mailchimp API key (found in Account > Extras > API keys)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here

# Your Mailchimp server prefix (e.g., us1, us2, etc.)
# This is the part after the dash in your API key (e.g., if your key ends with -us19, use us19)
MAILCHIMP_SERVER_PREFIX=us19

# Your Mailchimp Audience ID (found in Audience > Settings > Audience name and defaults)
MAILCHIMP_AUDIENCE_ID=your_audience_id_here


# Optional: Download directory for scout reports
# DOWNLOAD_DIR=./scout_reports
